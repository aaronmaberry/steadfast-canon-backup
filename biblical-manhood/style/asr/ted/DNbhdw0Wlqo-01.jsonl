{"start": 588.52, "end": 593.77, "text": "We needed an oil change in 300 miles.", "avg_logprob": -0.1122, "no_speech_prob": 0.0023, "compression_ratio": 1.7092}
{"start": 593.77, "end": 595.77, "text": "You were not just thinking about the oil change.", "avg_logprob": -0.1122, "no_speech_prob": 0.0023, "compression_ratio": 1.7092}
