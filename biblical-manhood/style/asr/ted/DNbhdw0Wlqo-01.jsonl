{"start": 515.98, "end": 518.0, "text": "if this has happened to you yet.", "avg_logprob": -0.1336, "no_speech_prob": 0.0189, "compression_ratio": 1.7477}
{"start": 518.0, "end": 519.78, "text": "But when we were first married,", "avg_logprob": -0.1336, "no_speech_prob": 0.0189, "compression_ratio": 1.7477}
